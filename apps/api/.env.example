# Kopiera till .env och fyll i. Hemligheter får aldrig checkas in i git.

NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
APP_NAME=Kursappen

# Postgres. Lämna tom lokalt så används en inbäddad databas i minnet.
DATABASE_URL=postgres://user:pass@host:5432/kursapp

# Webbas. Bas-URL = kundens domän + /api/site. Nyckeln finns i Webbas under
# Webbplatsinställningar > Integrationer. Grupp-id hämtas via GET /admin/webbas/groups.
WEBBAS_API_BASE_URL=https://www.kundensdoman.se/api/site
WEBBAS_API_KEY=
WEBBAS_MEMBER_GROUP_ID=
# Hemlighet som anges när standardwebhooken skapas i Webbas (eller via POST /admin/webbas/webhooks/install).
WEBBAS_WEBHOOK_SECRET=
# Token som automationens webhook-steg skickar med: .../webhooks/webbas/membership?action=removed&token=<denna>
WEBBAS_AUTOMATION_TOKEN=
WEBBAS_SYNC_HOUR=3

# Slumpa långa värden, t.ex. `openssl rand -base64 32`
AUTH_SECRET=
ADMIN_API_KEY=

# E-post för inloggningskoder: console (loggar) eller resend
EMAIL_PROVIDER=console
EMAIL_FROM=Kursappen <no-reply@kundensdoman.se>
RESEND_API_KEY=

# Media: passthrough (öppna länkar) eller bunny (signerade länkar)
MEDIA_PROVIDER=passthrough
MEDIA_URL_TTL_SECONDS=3600
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STORAGE_CDN_HOSTNAME=
BUNNY_STORAGE_TOKEN_KEY=
