{
  "name": "kursapp",
  "private": true,
  "version": "0.1.0",
  "description": "Kursapp f\u00f6r en Webbas-kund: backend med Webbas-synk och mobilapp (iOS/Android) f\u00f6r video, ljud, PDF och forum.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "api:dev": "pnpm --filter @kursapp/api dev",
    "api:test": "pnpm --filter @kursapp/api test",
    "api:typecheck": "pnpm --filter @kursapp/api typecheck",
    "mobile:start": "pnpm --filter @kursapp/mobile start",
    "mobile:typecheck": "pnpm --filter @kursapp/mobile typecheck",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
